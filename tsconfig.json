{
    "compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": false,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./resources/js/*"],
            "@booking": ["./app/Booking/Resources/js"],
            "@booking/*": ["./app/Booking/Resources/js/*"],
            "@properties": ["./app/Properties/Resources/js"],
            "@properties/*": ["./app/Properties/Resources/js/*"],
            "@posts": ["./app/Posts/Resources/js"],
            "@posts/*": ["./app/Posts/Resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "app/Booking/Resources/js/**/*.ts",
        "app/Booking/Resources/js/**/*.tsx",
        "app/Properties/Resources/js/**/*.ts",
        "app/Properties/Resources/js/**/*.tsx",
        "app/Posts/Resources/js/**/*.ts",
        "app/Posts/Resources/js/**/*.tsx"
    ]
}
