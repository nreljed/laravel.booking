{
    "compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": false,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./vendor/nreljed/dashboard-core/resources/js/*"],
            "@dashboard": ["./vendor/nreljed/dashboard-core/resources/js"],
            "@dashboard/*": ["./vendor/nreljed/dashboard-core/resources/js/*"],
            "@booking": ["./vendor/nreljed/booking-module/src/Booking/Resources/js"],
            "@booking/*": ["./vendor/nreljed/booking-module/src/Booking/Resources/js/*"],
            "@properties": ["./vendor/nreljed/booking-module/src/Properties/Resources/js"],
            "@properties/*": ["./vendor/nreljed/booking-module/src/Properties/Resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "app/Booking/Resources/js/**/*.ts",
        "app/Booking/Resources/js/**/*.tsx",
        "app/Booking/Resources/js/**/*.d.ts",
        "app/Properties/Resources/js/**/*.ts",
        "app/Properties/Resources/js/**/*.tsx",
        "app/Properties/Resources/js/**/*.d.ts",
        "vendor/nreljed/dashboard-core/resources/js/**/*.d.ts"
    ]
}
